{
  "schema_version": 2,
  "search": {
    "source_priority": ["official_company_sites", "official_ats"],
    "freshness_days": 14,
    "require_current_source": true
  },
  "evaluation": {
    "hard_exclusions": [],
    "preferred_signals": ["transformation", "program governance"],
    "unknown_is_not_match": true
  },
  "tracker": {
    "backend": "local_csv",
    "file": "tracker.csv",
    "update_policy": "allow",
    "stable_identity": true
  },
  "communications": {
    "first_contact_style": "concise",
    "external_action_mode": "draft_only",
    "external_action_mode_locked": true
  },
  "human_path": {
    "enabled": true,
    "search_contacts": true,
    "search_recruiter_or_poster": true,
    "search_hiring_manager": true,
    "require_current_source": true
  }
}
